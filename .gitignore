# Dependencies
node_modules/
frontend/node_modules/
backend/node_modules/

# Package manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Lockfiles
# 建议保留锁文件用于复现依赖版本，因此这里不忽略 package-lock.json / pnpm-lock.yaml

# Production builds
frontend/dist/
dist/
build/
*.tsbuildinfo

# Runtime data
backend/data/*.db
backend/data/*.sqlite
backend/data/*.sqlite3
.dev-processes.json
pids/
*.pid
*.pid.lock
*.seed
logs/
*.log

# Environment variables
.env
.env.*
!.env.example

# IDE
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Cache / temp
.cache/
.worktrees/
tmp/
temp/
.npm/

# Coverage
coverage/
.nyc_output/

# Optional package outputs
*.tgz
jspm_packages/
.node_repl_history
.yarn-integrity

# Local/private files
server/config.json

# 本地 AI 工作目录（含排查脚本、临时凭据、报告），绝不入库
.workbuddy-ai/
.tmp-*/
.pnpm-store/

docker/**/*.docker
docker/**/*.zip
docker/**/*.tar
docker/**/*.tar.gz
docker/**/*.tgz

# If you want to commit helper scripts later, remove this rule or add explicit exceptions.
*.bat
*.exe
*.bin
bin/
!scripts/bin/
!scripts/bin/sing-box-zenproxy-linux-amd64

# GitHub related files are allowed by default.

# ---- 禁止入库：本地部署脚本（含明文服务器凭据） ----
deploy.py
deploy_*.py
*.pem
id_rsa*
known_hosts

# ---- 禁止入库：发布归档（单个 400MB+，仓库不承载二进制发布物） ----
release-*.tar
release-*.bundle
release-*.tar.gz
release-*.zip

# ---- Python 缓存 ----
__pycache__/
*.py[cod]

# ---- 资源同步工具的本地产物（过期 bundle 暂存区） ----
_old_bundles/

# 逆向分析产物（体积大，不入库）
work/
*.apk
咸鱼之王_*.apk

# 本地一次性调试脚本
scripts/_peach_*.mjs
scripts/_probe_*.cjs
scripts/__pycache__/

# 运行时配置（含账号白名单，各环境独立）
backend/data/proxy_config.json
/data/
